<?xml version="1.0" encoding="utf-8"?>
<!-- SOLO en debug: HTTP sin TLS hacia la API del Mac, a la que el teléfono llega por la
     WiFi con la IP local del Mac (docs/gestion/entornos.md). Esa IP la asigna el router
     y cambia, y Android no acepta rangos de IP en domain-config: por eso se permite en
     base-config. Este archivo no entra al APK de release, que exige HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
