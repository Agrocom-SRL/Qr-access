# Plantilla. Copia a .env y completa; el .env real nunca se versiona.

# --- MySQL (docker compose) ---
MYSQL_DATABASE=qr_access
MYSQL_USER=qr_access
MYSQL_PASSWORD=qr_access
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=3307

# --- API ---
NODE_ENV=development
API_PORT=3000
DB_HOST=db
DB_PORT=3306
DB_DATABASE=qr_access
DB_USERNAME=qr_access
DB_PASSWORD=qr_access
# Base de tests: la fuerzan los tests, nunca apunta a la de desarrollo
DB_DATABASE_TEST=qr_access_testing

# JWT de usuarios (acceso corto + refresh)
JWT_SECRETO=cambia-esto
JWT_ACCESO_MINUTOS=15
JWT_REFRESH_DIAS=30

# Clave maestra para cifrar los secretos de QR en la base (32 bytes en base64)
QR_CLAVE_CIFRADO=
QR_PASO_SEGUNDOS=30

APP_ZONA_HORARIA=America/La_Paz
CORS_ORIGENES=http://localhost:8080

# --- dbmate ---
DATABASE_URL=mysql://qr_access:qr_access@db:3306/qr_access
