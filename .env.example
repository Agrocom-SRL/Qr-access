# Plantilla. Copia a .env y completa; el .env real nunca se versiona.

# --- MySQL (docker compose) ---
MYSQL_DATABASE=qr_access
MYSQL_USER=qr_access
MYSQL_PASSWORD=qr_access
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=3307

# --- API ---
NODE_ENV=development
API_PORT=3000
PANEL_PORT=8080
DB_HOST=db
DB_PORT=3306
DB_DATABASE=qr_access
DB_USERNAME=qr_access
DB_PASSWORD=qr_access
# Carpeta de los comprobantes de pago (ADR 0024). En docker es el volumen `archivos`; en local, una carpeta tuya.
# ARCHIVOS_RUTA=./archivos
# Base de tests: la fuerzan los tests, nunca apunta a la de desarrollo
DB_DATABASE_TEST=qr_access_testing

# JWT de usuarios (acceso corto + refresh). En producción: un secreto aleatorio de 32 bytes o más.
# El valor de abajo es SOLO de desarrollo: la API se niega a arrancar con uno de menos de 32 caracteres.
JWT_SECRETO=dev-jwt-secreto-solo-desarrollo-0123456789abcdef
JWT_ACCESO_MINUTOS=15
JWT_REFRESH_DIAS=30

# Pimienta del índice de PIN (ADR 0018): 32 bytes en base64, nunca en la base.
# El valor de abajo es SOLO de desarrollo y es el que usa la base de desarrollo para el índice de los PIN.
# En producción: `openssl rand -base64 32`, y cambiarla invalida todos los PIN.
PIN_PIMIENTA=ZGV2LXBpbWllbnRhLWFncm9jb20tYWNjZXNvLTAxMjM0NTY3ODk=

# true solo detrás de un proxy de confianza (Nginx): toma la IP del cliente de X-Forwarded-For
TRUST_PROXY=false

# --- Pools, tiempos y límites de uso (ADR 0030 §3, ADR 0032 §1). Todo es opcional: estos son los valores por defecto. ---
# Pools de MariaDB: uno reservado a las rutas del dispositivo y otro para la app y el panel.
# DB_POOL_DISPOSITIVOS=4
# DB_POOL_APP=6
# DB_COLA_DISPOSITIVOS=20
# DB_COLA_APP=50
# DB_ESPERA_MS_DISPOSITIVOS=500
# DB_ESPERA_MS_APP=3000
# Consulta < petición < 3000 ms de espera del firmware (la API no arranca si se rompe en los dispositivos).
# DB_CONSULTA_MS_DISPOSITIVOS=1500
# DB_CONSULTA_MS_APP=5000
# PETICION_MS_DISPOSITIVOS=2500
# PETICION_MS_APP=15000
# REINTENTO_503_SEGUNDOS=2
# Peticiones por minuto (la validación del dispositivo se cuenta por credencial y es holgada).
# LIMITE_LOGIN_POR_MINUTO=20
# LIMITE_REFRESCO_POR_MINUTO=60
# LIMITE_ANUNCIO_POR_MINUTO=20
# LIMITE_GENERAR_QR_POR_MINUTO=10
# LIMITE_ESCRITURA_POR_MINUTO=60
# LIMITE_LECTURA_POR_MINUTO=240
# LIMITE_VALIDACION_POR_MINUTO=600
# LIMITE_DISPOSITIVO_POR_MINUTO=120

APP_ZONA_HORARIA=America/La_Paz
CORS_ORIGENES=http://localhost:8080

# --- dbmate ---
DATABASE_URL=mysql://qr_access:qr_access@db:3306/qr_access
