# Plantilla. Copia a .env y completa; el .env real nunca se versiona.

# --- MySQL (docker compose) ---
MYSQL_DATABASE=qr_access
MYSQL_USER=qr_access
MYSQL_PASSWORD=qr_access
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=3307

# --- API ---
NODE_ENV=development
API_PORT=3000
DB_HOST=db
DB_PORT=3306
DB_DATABASE=qr_access
DB_USERNAME=qr_access
DB_PASSWORD=qr_access
# Base de tests: la fuerzan los tests, nunca apunta a la de desarrollo
DB_DATABASE_TEST=qr_access_testing

# JWT de usuarios (acceso corto + refresh). En producción: un secreto aleatorio de 32 bytes o más.
# El valor de abajo es SOLO de desarrollo: la API se niega a arrancar con uno de menos de 32 caracteres.
JWT_SECRETO=dev-jwt-secreto-solo-desarrollo-0123456789abcdef
JWT_ACCESO_MINUTOS=15
JWT_REFRESH_DIAS=30

# Pimienta del índice de PIN (ADR 0018): 32 bytes en base64, nunca en la base.
# El valor de abajo es SOLO de desarrollo y es el que usan los PIN de db/seeds/02_demo.sql (cuenta DEM).
# En producción: `openssl rand -base64 32`, y cambiarla invalida todos los PIN.
PIN_PIMIENTA=ZGV2LXBpbWllbnRhLWFncm9jb20tYWNjZXNvLTAxMjM0NTY3ODk=

# true solo detrás de un proxy de confianza (Nginx): toma la IP del cliente de X-Forwarded-For
TRUST_PROXY=false

APP_ZONA_HORARIA=America/La_Paz
CORS_ORIGENES=http://localhost:8080

# --- dbmate ---
DATABASE_URL=mysql://qr_access:qr_access@db:3306/qr_access
