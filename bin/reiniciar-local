#!/usr/bin/env bash
# Deja la base de DESARROLLO como queda la de producción tras su reinicio (jerarquia-de-usuarios.md §13):
# respaldo previo, base recreada, migraciones, catálogo de permisos y solo el super admin de desarrollo
# `root` (contraseña temporal 0000, que el panel obliga a cambiar). Sin cuentas ni datos demo.
#
# Solo toca `qr_access` del contenedor `db` local; nunca `qr_access_testing` ni volúmenes (-v).
# Pide confirmación escribiendo REINICIAR (o `--si` para saltarla). Uso: bin/reiniciar-local [--si]
set -euo pipefail

cd "$(dirname "$0")/.."
confirmado=0
for arg in "$@"; do
  case "$arg" in
    --si) confirmado=1 ;;
    *) echo "Uso: bin/reiniciar-local [--si]" >&2; exit 2 ;;
  esac
done

mysql_root() { docker compose exec -T db sh -c 'mariadb -uroot -p"$MARIADB_ROOT_PASSWORD" --default-character-set=utf8mb4 "$@"' -- "$@"; }
base=qr_access

if [ "$confirmado" -ne 1 ]; then
  echo "Esto borra TODOS los datos de la base local '$base' (se hace un respaldo antes)."
  read -r -p "Escribe REINICIAR para continuar: " respuesta
  [ "$respuesta" = "REINICIAR" ] || { echo "Cancelado."; exit 1; }
fi

echo "==> Respaldo"
mkdir -p respaldos
respaldo="respaldos/${base}-$(date +%Y%m%d-%H%M%S).sql"
docker compose exec -T db sh -c 'mariadb-dump -uroot -p"$MARIADB_ROOT_PASSWORD" --single-transaction --routines --default-character-set=utf8mb4 '"$base" > "$respaldo" 2>/dev/null
[ -s "$respaldo" ] || { echo "El respaldo quedó vacío: no se toca la base." >&2; rm -f "$respaldo"; exit 1; }
echo "Guardado en $respaldo"

echo "==> Deteniendo la API"
docker compose stop api >/dev/null

echo "==> Recreando la base"
mysql_root -e "DROP DATABASE IF EXISTS \`$base\`; CREATE DATABASE \`$base\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci; GRANT ALL ON \`$base\`.* TO 'qr_access'@'%';"

echo "==> Migraciones y catálogo"
docker compose --profile herramientas run --rm dbmate up
mysql_root "$base" < db/seeds/01_catalogo.sql

echo "==> Super admin root (contraseña temporal 0000: el panel obliga a cambiarla al primer ingreso)"
# argon2id con los mismos parámetros que bin/desplegar; contrasena_temporal = 1 como en producción.
hash=$(docker compose run --rm --no-deps -e CLAVE=0000 api node -e "
  import('argon2').then(async (a) => {
    process.stdout.write(await a.hash(process.env.CLAVE, { type: a.argon2id, memoryCost: 19456, timeCost: 2, parallelism: 1 }));
  });
")
mysql_root "$base" <<SQL
SET NAMES utf8mb4;
INSERT INTO usuarios (tenant_id, etiqueta, username, contrasena_hash, contrasena_temporal, activo)
  VALUES (NULL, 'Root', 'root', '$hash', 1, 1);
INSERT INTO usuario_roles (tenant_id, usuario_id, rol_id)
  SELECT NULL, u.id, r.id FROM usuarios u
    JOIN roles r ON r.tenant_id IS NULL AND r.nombre = 'Super admin' AND r.deleted_at IS NULL
   WHERE u.tenant_id IS NULL AND u.username = 'root' AND u.deleted_at IS NULL;
SQL

echo "==> Levantando la API"
docker compose up -d api >/dev/null
echo "Listo. Las placas vinculadas hay que vincularlas de nuevo."
