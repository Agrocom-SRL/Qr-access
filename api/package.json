{
  "name": "agrocom-acceso-api",
  "version": "0.0.0",
  "private": true,
  "description": "API REST de AGROCOM Acceso",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "arquitectura": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/swagger": "^9.9.1",
    "argon2": "^0.45.1",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.12",
    "mysql2": "^3.24.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  }
}
